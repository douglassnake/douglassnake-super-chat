ENVIRONMENT=development
POSTGRES_DB=superchat
POSTGRES_USER=superchat
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://superchat:change-me@localhost:5432/superchat

# M9.2 — backend de segredos.
# development: settings (valores abaixo/.env privado).
# self-hosted protegido: files + diretório montado read-only fora do repositório.
SECRET_BACKEND=settings
SECRET_DIR=

# Quando SECRET_BACKEND=files, crie arquivos UTF-8 privados com estes nomes
# conforme necessário (sem prefixo de variável):
# auth_password_hash
# github_token
# google_access_token
# google_client_secret
# google_refresh_token
# executor_github_write_token
# executor_github_publish_token
# Em POSIX, não conceda permissões a "others"; 0640/0440 são aceitos.

# M9.0 — autenticação single-admin. Em production, AUTH_ENABLED=true,
# AUTH_PASSWORD_HASH válido e AUTH_COOKIE_SECURE=true são obrigatórios.
AUTH_ENABLED=false
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
AUTH_SESSION_TTL_SECONDS=43200
AUTH_COOKIE_NAME=superchat_session
AUTH_CSRF_COOKIE_NAME=superchat_csrf
AUTH_COOKIE_SECURE=false

# Gere AUTH_PASSWORD_HASH localmente com:
# python scripts/generate_password_hash.py
# Se usar SECRET_BACKEND=files, grave a saída em <SECRET_DIR>/auth_password_hash.

# M9.3 — binding e rotação de logs para self-hosting.
# O default 127.0.0.1 evita exposição direta; o reverse proxy HTTPS deve
# publicar a aplicação. Não use 0.0.0.0 antes do checklist ZimaOS.
SUPERCHAT_BIND_HOST=127.0.0.1
SUPERCHAT_BIND_PORT=8000
SUPERCHAT_LOG_MAX_SIZE=10m
SUPERCHAT_LOG_MAX_FILES=5
SUPERCHAT_SECRET_DIR_HOST=

# GitHub: opcional para repositórios privados ou maior limite de API de leitura.
# Nunca versionar um token real.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Google: somente leitura. Use um access token temporário OU o trio OAuth
# client/secret/refresh token na instalação privada. Nunca versionar valores reais.
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_DRIVE_API_URL=https://www.googleapis.com/drive/v3
GOOGLE_CALENDAR_API_URL=https://www.googleapis.com/calendar/v3

# Executor isolado. DESLIGADO por padrão.
EXECUTOR_ISOLATED_ENABLED=false
EXECUTOR_WORKTREE_ROOT=
EXECUTOR_TIMEOUT_SECONDS=60
EXECUTOR_MAX_TIMEOUT_SECONDS=300
EXECUTOR_OUTPUT_MAX_BYTES=65536
EXECUTOR_ENV_ALLOWLIST=SYSTEMROOT,TEMP,TMP,TMPDIR

EXECUTOR_WORKER_BACKEND=subprocess-sandbox
EXECUTOR_WORKER_CPU_SECONDS=120
EXECUTOR_WORKER_MEMORY_MB=1024
EXECUTOR_WORKER_PIDS=128
EXECUTOR_WORKER_NOFILE=256
EXECUTOR_WORKER_FILE_SIZE_MB=64
EXECUTOR_CONTAINER_RUNTIME=docker
EXECUTOR_CONTAINER_IMAGE=python:3.13-slim

EXECUTOR_WORKER_LEASE_SECONDS=120
EXECUTOR_WORKER_MAX_ATTEMPTS=3

EXECUTOR_MODIFY_MAX_FILES=20
EXECUTOR_MODIFY_MAX_OPERATIONS=40
EXECUTOR_MODIFY_MAX_TOTAL_WRITE_BYTES=65536
EXECUTOR_MODIFY_MAX_PATCH_BYTES=65536

# M8.10 — diretório privado para worktrees Git dedicados.
EXECUTOR_GIT_STAGING_ROOT=

# M8.11 — identidade exclusiva de commits locais.
EXECUTOR_GIT_AUTHOR_NAME=Super Chat Executor
EXECUTOR_GIT_AUTHOR_EMAIL=superchat-executor@localhost

# M8.12 — remote bare LOCAL controlado pelo servidor.
EXECUTOR_GIT_PUBLISH_REMOTE=
EXECUTOR_GIT_PUBLISH_REMOTE_ID=controlled-bare

# M8.13 — writer GitHub para criar PR, separado do worker e desligado por padrão.
EXECUTOR_GITHUB_WRITE_ENABLED=false
EXECUTOR_GITHUB_WRITE_TOKEN=
EXECUTOR_GITHUB_WRITE_REPOSITORY=owner/repository
EXECUTOR_GITHUB_PR_BASE_BRANCH=main
EXECUTOR_GITHUB_PR_DRAFT=true

# M8.14 — publicação autenticada de branch via credential broker.
# Use token dedicado/minimamente privilegiado. Nunca versionar valor real.
EXECUTOR_GITHUB_PUBLISH_ENABLED=false
EXECUTOR_GITHUB_PUBLISH_TOKEN=
EXECUTOR_GITHUB_PUBLISH_REPOSITORY=owner/repository
